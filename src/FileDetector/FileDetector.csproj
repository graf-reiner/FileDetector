<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileDetector</RootNamespace>
    <AssemblyName>FileDetector</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      Single source of truth for the version. tools\bump-version.ps1 edits this line and nothing
      else; AssemblyVersion and FileVersion are derived, and AppVersion reads it back at runtime.
      build.ps1 passes SourceRevisionId, which MSBuild appends to InformationalVersion as
      "1.0.0+<short sha>" so a shipped exe can be traced to a commit.
    -->
    <VersionPrefix>1.0.2</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Product>FileDetector</Product>
    <Description>Windows tray utility that watches folders and reports new, renamed and deleted items — including changes made while it was not running.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded rather than copied so single-file publish keeps the tray icons. -->
    <EmbeddedResource Include="..\..\assets\app.ico" LogicalName="FileDetector.app.ico" />
    <EmbeddedResource Include="..\..\assets\app-paused.ico" LogicalName="FileDetector.app-paused.ico" />
  </ItemGroup>

</Project>
